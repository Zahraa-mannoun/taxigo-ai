GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/taxigo
FRONTEND_ORIGIN=https://your-production-domain.com

# Optional: up to 2 backup Groq API keys. If the primary key hits a rate
# limit (429), services/ai_agent.py automatically retries the SAME request
# on the next configured key, in order. Leave unset to use only GROQ_API_KEY.
GROQ_API_KEY_BACKUP1=
GROQ_API_KEY_BACKUP2=

# Optional: overrides the Groq model used for chat classification (see
# services/ai_agent.py). Defaults to openai/gpt-oss-20b -- Groq deprecated
# the previous default, llama-3.3-70b-versatile, on 2026-06-17.
GROQ_MODEL=openai/gpt-oss-20b

# Optional: set to 1/true to auto-create tables on startup via create_all()
# (convenient for local dev against a throwaway DB). Leave unset in
# production -- Alembic (`alembic upgrade head`) should be the only source
# of truth there, so schema drift can't silently happen.
DEV_MODE=1

# Optional: if set, every non-static/non-health request must include a
# matching `X-API-Secret` header (see main.py's auth_middleware). Leave
# unset to keep the API open, e.g. for local development.
API_SECRET=
